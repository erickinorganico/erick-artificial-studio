[
 {"id": "f01", "texto": "Le pregunté a la IA:", "a": 0.000, "b": 1.210},
 {"id": "f02", "texto": "«¿Qué chilaquiles prefieren mis clientes?».", "a": 1.483, "b": 3.273},
 {"id": "f03", "texto": "Revisó mi Excel:", "a": 3.546, "b": 4.361},
 {"id": "f04", "texto": "ochenta rojos, cincuenta verdes.", "a": 4.606, "b": 6.553},
 {"id": "f05", "texto": "«Los rojos»,", "a": 6.855, "b": 7.422},
 {"id": "f06", "texto": "respondió.", "a": 7.582, "b": 8.043},
 {"id": "f07", "texto": "Contó bien.", "a": 8.352, "b": 8.931},
 {"id": "f08", "texto": "Pero", "a": 9.243, "b": 9.633},
 {"id": "f09", "texto": "¿respondió bien?", "a": 9.785, "b": 10.755},
 {"id": "f10", "texto": "Imagina que los verdes se agotaron varios días.", "a": 11.083, "b": 13.320},
 {"id": "f11", "texto": "Alguien quería verdes…", "a": 13.557, "b": 14.640},
 {"id": "f12", "texto": "y terminó pidiendo rojos.", "a": 14.786, "b": 16.237},
 {"id": "f13", "texto": "El ticket registra rojos.", "a": 16.441, "b": 18.038},
 {"id": "f14", "texto": "Su primera opción", "a": 18.227, "b": 19.051},
 {"id": "f15", "texto": "era otra.", "a": 19.144, "b": 19.646},
 {"id": "f16", "texto": "Esas ventas dicen qué se compró,", "a": 19.973, "b": 21.605},
 {"id": "f17", "texto": "con las opciones que había.", "a": 21.798, "b": 22.793},
 {"id": "f18", "texto": "No bastan para saber", "a": 22.999, "b": 24.065},
 {"id": "f19", "texto": "qué preferían.", "a": 24.169, "b": 24.849},
 {"id": "f20", "texto": "Si quieres saber qué vendió más,", "a": 25.164, "b": 26.698},
 {"id": "f21", "texto": "cuenta las ventas.", "a": 26.860, "b": 27.745},
 {"id": "f22", "texto": "Si quieres conocer preferencias,", "a": 27.938, "b": 29.418},
 {"id": "f23", "texto": "revisa también", "a": 29.505, "b": 30.253},
 {"id": "f24", "texto": "qué había disponible y pregunta a los clientes.", "a": 30.345, "b": 32.590},
 {"id": "f25", "texto": "Antes de pedirle conclusiones a la IA,", "a": 32.854, "b": 34.696},
 {"id": "f26", "texto": "agrega:", "a": 34.808, "b": 35.236},
 {"id": "f27", "texto": "«¿Estos datos responden mi pregunta?", "a": 35.478, "b": 37.091},
 {"id": "f28", "texto": "¿Qué información falta?».", "a": 37.400, "b": 38.406},
 {"id": "f29", "texto": "Yo sigo con los verdes.", "a": 38.714, "b": 39.948},
 {"id": "f30", "texto": "Eso sí:", "a": 40.204, "b": 40.589},
 {"id": "f31", "texto": "por gusto,", "a": 40.816, "b": 41.341},
 {"id": "f32", "texto": "no por Excel.", "a": 41.530, "b": 42.224}
]
